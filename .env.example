DISCORD_TOKEN=seu_token_do_discord
HUGGINGFACE_TOKEN=seu_token_da_huggingface

# Servidor local: fica ativo apenas enquanto o bot estiver aberto.
LOCAL_SERVER_ENABLED=true
LOCAL_SERVER_HOST=127.0.0.1
LOCAL_SERVER_PORT=8080

# Opcional: troque os modelos de imagem.
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers
HF_IMAGE_MODEL_FLUX=black-forest-labs/FLUX.1-schnell
HF_IMAGE_MODEL_FLUX_UNCENSORED=enhanceaiteam/Flux-uncensored

# Opcional: endpoint dedicado caso o modelo nao esteja disponivel no serverless.
HF_IMAGE_ENDPOINT_FLUX_UNCENSORED=
